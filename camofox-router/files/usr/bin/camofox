#!/bin/sh
# CamoFox - Tethering Bypass Management Tool
# Main CLI interface for the CamoFox router plugin.
#
# Transparently tunnels all LAN traffic through a SOCKS5 proxy on iPhone,
# hiding tethering usage from T-Mobile.
#
# Usage: camofox <command> [options]
#
# Commands:
#   start    - Start CamoFox services
#   stop     - Stop CamoFox services
#   restart  - Restart CamoFox services
#   status   - Show detailed status of all components
#   setup    - Run interactive setup wizard
#   test     - Run connectivity and leak tests
#   logs     - Show CamoFox-related logs
#   enable   - Enable CamoFox at boot
#   disable  - Disable CamoFox at boot
#   version  - Show version information

VERSION="1.0.0"
NAME="CamoFox"
INIT_SCRIPT="/etc/init.d/camofox"
FW_SCRIPT="/etc/camofox/firewall.rules"
HEALTH_SCRIPT="/etc/camofox/health_check.sh"

. /lib/functions.sh

# ---------------------------------------------------------------------------
# Configuration loader
# ---------------------------------------------------------------------------
load_config() {
    config_load camofox
    config_get ENABLED        main enabled          '0'
    config_get PROXY_IP       main proxy_ip         '172.20.10.1'
    config_get PROXY_PORT     main proxy_port       '9876'
    config_get HTTP_PORT      main http_proxy_port  '1081'
    config_get PROXY_TYPE     main proxy_type       'socks5'
    config_get CONN_MODE      main connection_mode  'usb'
    config_get AUTO_DETECT    main auto_detect      '1'
    config_get TTL_VALUE      main ttl_value        '65'
    config_get TTL_ENABLED    main ttl_enabled      '1'
    config_get KILL_SWITCH    main kill_switch      '1'
    config_get DOH_ENABLED    main doh_enabled      '1'
    config_get DOH_RESOLVER   main doh_resolver     'https://cloudflare-dns.com/dns-query'
    config_get HEALTH_INTERVAL main health_interval  '30'
    config_get REDSOCKS_PORT  main redsocks_port    '12345'
    config_get LAN_IFACE      main lan_iface        'br-lan'
    config_get LOG_LEVEL      main log_level        '1'
}

# ---------------------------------------------------------------------------
# Color/formatting helpers (works with busybox printf)
# ---------------------------------------------------------------------------
BOLD="\033[1m"
GREEN="\033[32m"
RED="\033[31m"
YELLOW="\033[33m"
CYAN="\033[36m"
RESET="\033[0m"

print_ok()   { printf "  ${GREEN}✓${RESET} %s\n" "$1"; }
print_fail() { printf "  ${RED}✗${RESET} %s\n" "$1"; }
print_warn() { printf "  ${YELLOW}!${RESET} %s\n" "$1"; }
print_info() { printf "  ${CYAN}•${RESET} %s\n" "$1"; }

banner() {
    printf "\n${BOLD}${CYAN}"
    printf "  ╔═══════════════════════════════════════╗\n"
    printf "  ║          CamoFox v%s               ║\n" "$VERSION"
    printf "  ║    Tethering Bypass for GL-iNet      ║\n"
    printf "  ╚═══════════════════════════════════════╝${RESET}\n\n"
}

# ---------------------------------------------------------------------------
# Command: start
# ---------------------------------------------------------------------------
cmd_start() {
    banner
    printf "${BOLD}Starting CamoFox...${RESET}\n\n"

    load_config

    if [ "$ENABLED" != "1" ]; then
        print_fail "CamoFox is disabled. Run 'camofox enable' first."
        return 1
    fi

    if ! [ -x "$INIT_SCRIPT" ]; then
        print_fail "Init script not found at $INIT_SCRIPT"
        return 1
    fi

    # Check if redsocks is installed
    if ! command -v redsocks >/dev/null 2>&1; then
        print_fail "redsocks is not installed. Run 'opkg install redsocks' first."
        return 1
    fi

    $INIT_SCRIPT start
    ret=$?

    sleep 2
    echo ""

    if [ $ret -eq 0 ]; then
        # Verify services actually started
        if pidof redsocks >/dev/null 2>&1; then
            print_ok "redsocks is running"
        else
            print_fail "redsocks failed to start"
            ret=1
        fi

        # Check proxy connectivity
        if [ -x "$HEALTH_SCRIPT" ]; then
            if "$HEALTH_SCRIPT" test 2>/dev/null | grep -q "REACHABLE"; then
                print_ok "SOCKS5 proxy reachable at $PROXY_IP:$PROXY_PORT"
            else
                print_warn "SOCKS5 proxy NOT reachable at $PROXY_IP:$PROXY_PORT"
                print_info "Make sure iOS-SOCKS-Server is running on your iPhone"
            fi
        fi

        # Check firewall
        if iptables -t nat -L REDSOCKS -n >/dev/null 2>&1; then
            print_ok "Firewall rules applied"
        else
            print_fail "Firewall rules NOT applied"
            ret=1
        fi

        if [ $ret -eq 0 ]; then
            printf "\n${GREEN}${BOLD}CamoFox is running!${RESET}\n"
        else
            printf "\n${YELLOW}${BOLD}CamoFox started with warnings.${RESET}\n"
        fi
    else
        print_fail "Failed to start CamoFox"
    fi

    return $ret
}

# ---------------------------------------------------------------------------
# Command: stop
# ---------------------------------------------------------------------------
cmd_stop() {
    banner
    printf "${BOLD}Stopping CamoFox...${RESET}\n\n"

    if [ -x "$INIT_SCRIPT" ]; then
        $INIT_SCRIPT stop
    fi

    sleep 1

    if pidof redsocks >/dev/null 2>&1; then
        print_warn "redsocks still running, force killing"
        killall redsocks 2>/dev/null
    fi

    print_ok "CamoFox stopped"
    print_info "All traffic now flows normally (unproxied)"
}

# ---------------------------------------------------------------------------
# Command: restart
# ---------------------------------------------------------------------------
cmd_restart() {
    banner
    printf "${BOLD}Restarting CamoFox...${RESET}\n\n"

    if [ -x "$INIT_SCRIPT" ]; then
        $INIT_SCRIPT stop
        sleep 2
        $INIT_SCRIPT start
    fi

    sleep 2
    cmd_status_brief
}

# ---------------------------------------------------------------------------
# Command: status
# ---------------------------------------------------------------------------
cmd_status() {
    banner
    load_config

    printf "${BOLD}Configuration:${RESET}\n"
    print_info "Enabled: $([ "$ENABLED" = '1' ] && echo 'YES' || echo 'NO')"
    print_info "Connection: $CONN_MODE"
    print_info "Proxy: $PROXY_IP:$PROXY_PORT ($PROXY_TYPE)"
    print_info "TTL: $([ "$TTL_ENABLED" = '1' ] && echo "enabled ($TTL_VALUE)" || echo 'disabled')"
    print_info "Kill switch: $([ "$KILL_SWITCH" = '1' ] && echo 'enabled' || echo 'disabled')"
    print_info "DoH: $([ "$DOH_ENABLED" = '1' ] && echo 'enabled' || echo 'disabled')"
    echo ""

    printf "${BOLD}Services:${RESET}\n"

    # redsocks
    if pidof redsocks >/dev/null 2>&1; then
        print_ok "redsocks: running (PID $(pidof redsocks))"
    else
        print_fail "redsocks: not running"
    fi

    # Health monitor
    HEALTH_PID="/var/run/camofox_health.pid"
    if [ -f "$HEALTH_PID" ] && kill -0 "$(cat $HEALTH_PID)" 2>/dev/null; then
        print_ok "Health monitor: running (PID $(cat $HEALTH_PID))"
        proxy_state=$(cat /tmp/camofox_proxy_state 2>/dev/null || echo 'unknown')
        case "$proxy_state" in
            up)   print_ok "Proxy state: UP" ;;
            down) print_fail "Proxy state: DOWN" ;;
            *)    print_warn "Proxy state: $proxy_state" ;;
        esac
    else
        print_fail "Health monitor: not running"
    fi

    # https-dns-proxy
    if [ "$DOH_ENABLED" = "1" ]; then
        if pidof https-dns-proxy >/dev/null 2>&1; then
            print_ok "DNS-over-HTTPS: running"
        else
            print_fail "DNS-over-HTTPS: not running"
        fi
    fi
    echo ""

    printf "${BOLD}Firewall:${RESET}\n"
    if iptables -t nat -L REDSOCKS -n >/dev/null 2>&1; then
        print_ok "REDSOCKS chain: active"
        rule_count=$(iptables -t nat -L REDSOCKS -n 2>/dev/null | grep -c '^')
        print_info "  Rules in chain: $((rule_count - 2))"  # minus header lines
    else
        print_fail "REDSOCKS chain: not found"
    fi

    if iptables -t mangle -L POSTROUTING -n 2>/dev/null | grep -qi ttl; then
        print_ok "TTL mangling: active"
    else
        print_warn "TTL mangling: not active"
    fi

    if iptables -L FORWARD -n 2>/dev/null | grep -q "dpt:53"; then
        print_ok "DNS leak prevention: active"
    else
        print_warn "DNS leak prevention: not active"
    fi

    if iptables -L CAMOFOX_KILLSW -n >/dev/null 2>&1; then
        if iptables -L CAMOFOX_KILLSW -n 2>/dev/null | grep -q DROP; then
            print_fail "Kill switch: ENGAGED (traffic blocked!)"
        else
            print_ok "Kill switch: armed (traffic flowing)"
        fi
    else
        print_info "Kill switch: not configured"
    fi
    echo ""

    # Network info
    printf "${BOLD}Network:${RESET}\n"
    case "$CONN_MODE" in
        usb)
            for dev in usb0 eth2 eth1; do
                if ip link show "$dev" >/dev/null 2>&1; then
                    ip_addr=$(ip -4 addr show "$dev" 2>/dev/null | grep inet | awk '{print $2}')
                    print_info "USB interface: $dev ($ip_addr)"
                    break
                fi
            done
            ;;
        wifi)
            for dev in wlan-sta0 wlan0-1 apcli0; do
                if ip link show "$dev" >/dev/null 2>&1; then
                    ip_addr=$(ip -4 addr show "$dev" 2>/dev/null | grep inet | awk '{print $2}')
                    print_info "WiFi client: $dev ($ip_addr)"
                    break
                fi
            done
            ;;
    esac

    # Gateway
    gw=$(ip route | grep default | head -1 | awk '{print $3}')
    if [ -n "$gw" ]; then
        print_info "Default gateway: $gw"
    fi
    echo ""
}

cmd_status_brief() {
    load_config
    printf "\n${BOLD}Quick Status:${RESET}\n"
    if pidof redsocks >/dev/null 2>&1; then
        print_ok "redsocks running"
    else
        print_fail "redsocks not running"
    fi
    proxy_state=$(cat /tmp/camofox_proxy_state 2>/dev/null || echo 'unknown')
    if [ "$proxy_state" = "up" ]; then
        print_ok "Proxy reachable"
    else
        print_warn "Proxy state: $proxy_state"
    fi
    echo ""
}

# ---------------------------------------------------------------------------
# Command: test
# ---------------------------------------------------------------------------
cmd_test() {
    banner
    load_config
    printf "${BOLD}Running CamoFox Diagnostics...${RESET}\n\n"

    # Test 1: Proxy reachability
    printf "${BOLD}[1/6] SOCKS5 Proxy Connectivity${RESET}\n"
    if [ -x "$HEALTH_SCRIPT" ]; then
        if "$HEALTH_SCRIPT" test 2>/dev/null | grep -q "REACHABLE"; then
            print_ok "SOCKS5 proxy reachable at $PROXY_IP:$PROXY_PORT"
        else
            print_fail "SOCKS5 proxy NOT reachable at $PROXY_IP:$PROXY_PORT"
            print_info "Ensure iOS-SOCKS-Server is running on iPhone"
            print_info "Ensure iPhone is connected via $CONN_MODE"
        fi
    else
        print_warn "Health check script not available"
    fi
    echo ""

    # Test 2: redsocks running
    printf "${BOLD}[2/6] redsocks Service${RESET}\n"
    if pidof redsocks >/dev/null 2>&1; then
        print_ok "redsocks is running (PID $(pidof redsocks))"
        # Check if redsocks port is listening
        if netstat -tlnp 2>/dev/null | grep -q ":${REDSOCKS_PORT}"; then
            print_ok "Listening on port $REDSOCKS_PORT"
        else
            print_fail "NOT listening on port $REDSOCKS_PORT"
        fi
    else
        print_fail "redsocks is NOT running"
    fi
    echo ""

    # Test 3: Firewall rules
    printf "${BOLD}[3/6] Firewall Rules${RESET}\n"
    if iptables -t nat -L REDSOCKS -n >/dev/null 2>&1; then
        print_ok "REDSOCKS nat chain exists"
    else
        print_fail "REDSOCKS nat chain missing"
    fi
    if iptables -t nat -L PREROUTING -n 2>/dev/null | grep -q REDSOCKS; then
        print_ok "PREROUTING redirects to REDSOCKS"
    else
        print_fail "PREROUTING does not redirect to REDSOCKS"
    fi
    if iptables -t mangle -L POSTROUTING -n 2>/dev/null | grep -qi ttl; then
        print_ok "TTL mangling active"
    else
        print_warn "TTL mangling not active"
    fi
    echo ""

    # Test 4: DNS configuration
    printf "${BOLD}[4/6] DNS Leak Prevention${RESET}\n"
    if [ "$DOH_ENABLED" = "1" ]; then
        if pidof https-dns-proxy >/dev/null 2>&1; then
            print_ok "DNS-over-HTTPS proxy running"
        else
            print_fail "DNS-over-HTTPS proxy NOT running"
        fi
        if iptables -L FORWARD -n 2>/dev/null | grep -q "dpt:53.*DROP"; then
            print_ok "Direct DNS (UDP:53) blocked on FORWARD"
        else
            print_warn "Direct DNS not blocked — potential leak"
        fi
    else
        print_warn "DNS-over-HTTPS is disabled"
    fi
    echo ""

    # Test 5: External connectivity through proxy
    printf "${BOLD}[5/6] External Connectivity${RESET}\n"
    # Try to fetch a page through the proxy
    if command -v wget >/dev/null 2>&1; then
        test_url="http://ifconfig.me/ip"
        ext_ip=$(wget -q -O - --timeout=10 "$test_url" 2>/dev/null)
        if [ -n "$ext_ip" ]; then
            print_ok "External connectivity works"
            print_info "External IP: $ext_ip"
        else
            print_fail "Cannot reach external sites"
            print_info "Check proxy and firewall configuration"
        fi
    else
        print_warn "wget not available, skipping connectivity test"
    fi
    echo ""

    # Test 6: TTL verification
    printf "${BOLD}[6/6] TTL Verification${RESET}\n"
    if [ "$TTL_ENABLED" = "1" ]; then
        # Check current mangle rules
        ttl_rule=$(iptables -t mangle -L POSTROUTING -n -v 2>/dev/null | grep -i "ttl set to $TTL_VALUE")
        if [ -n "$ttl_rule" ]; then
            print_ok "TTL set to $TTL_VALUE on all outbound"
        else
            ttl_rule=$(iptables -t mangle -L POSTROUTING -n -v 2>/dev/null | grep -i ttl)
            if [ -n "$ttl_rule" ]; then
                print_ok "TTL mangling active (verify value manually)"
            else
                print_fail "TTL mangling rule not found"
            fi
        fi
    else
        print_info "TTL mangling disabled in config"
    fi
    echo ""

    printf "${BOLD}Diagnostics complete.${RESET}\n\n"
}

# ---------------------------------------------------------------------------
# Command: logs
# ---------------------------------------------------------------------------
cmd_logs() {
    banner
    printf "${BOLD}CamoFox Logs (last 50 entries):${RESET}\n\n"
    logread 2>/dev/null | grep -E 'camofox|redsocks|https-dns-proxy' | tail -50
    echo ""
    printf "${CYAN}Tip: Use 'logread -f | grep camofox' for real-time logs${RESET}\n"
}

# ---------------------------------------------------------------------------
# Command: enable/disable
# ---------------------------------------------------------------------------
cmd_enable() {
    uci set camofox.main.enabled='1'
    uci commit camofox
    if [ -x "$INIT_SCRIPT" ]; then
        $INIT_SCRIPT enable
    fi
    print_ok "CamoFox enabled (will start at boot)"
    print_info "Run 'camofox start' to start now"
}

cmd_disable() {
    uci set camofox.main.enabled='0'
    uci commit camofox
    if [ -x "$INIT_SCRIPT" ]; then
        $INIT_SCRIPT disable
    fi
    print_ok "CamoFox disabled (will not start at boot)"
    print_info "Run 'camofox stop' to stop now"
}

# ---------------------------------------------------------------------------
# Command: setup (delegates to wizard)
# ---------------------------------------------------------------------------
cmd_setup() {
    WIZARD="/usr/lib/camofox/setup-wizard.sh"
    if [ -x "$WIZARD" ]; then
        exec "$WIZARD"
    fi
    # Fallback: check scripts directory
    WIZARD2="/etc/camofox/setup-wizard.sh"
    if [ -x "$WIZARD2" ]; then
        exec "$WIZARD2"
    fi
    print_fail "Setup wizard not found"
    print_info "Run the installer first: sh /tmp/camofox-install.sh"
    return 1
}

# ---------------------------------------------------------------------------
# Command: version
# ---------------------------------------------------------------------------
cmd_version() {
    echo "$NAME v$VERSION"
    echo "Tethering bypass plugin for GL-iNet routers"
    echo "https://github.com/nneonneo/iOS-SOCKS-Server"
}

# ---------------------------------------------------------------------------
# Usage
# ---------------------------------------------------------------------------
usage() {
    banner
    printf "${BOLD}Usage:${RESET} camofox <command>\n\n"
    printf "${BOLD}Commands:${RESET}\n"
    printf "  ${CYAN}start${RESET}     Start CamoFox services\n"
    printf "  ${CYAN}stop${RESET}      Stop CamoFox services\n"
    printf "  ${CYAN}restart${RESET}   Restart CamoFox services\n"
    printf "  ${CYAN}status${RESET}    Show detailed status of all components\n"
    printf "  ${CYAN}setup${RESET}     Run interactive setup wizard\n"
    printf "  ${CYAN}test${RESET}      Run connectivity and leak diagnostics\n"
    printf "  ${CYAN}logs${RESET}      Show CamoFox-related logs\n"
    printf "  ${CYAN}enable${RESET}    Enable CamoFox at boot\n"
    printf "  ${CYAN}disable${RESET}   Disable CamoFox at boot\n"
    printf "  ${CYAN}version${RESET}   Show version information\n"
    echo ""
}

# ---------------------------------------------------------------------------
# Main dispatcher
# ---------------------------------------------------------------------------
case "$1" in
    start)   cmd_start ;;
    stop)    cmd_stop ;;
    restart) cmd_restart ;;
    status)  cmd_status ;;
    setup)   cmd_setup ;;
    test)    cmd_test ;;
    logs)    cmd_logs ;;
    enable)  cmd_enable ;;
    disable) cmd_disable ;;
    version) cmd_version ;;
    -h|--help|help|"")
        usage
        ;;
    *)
        printf "${RED}Unknown command: $1${RESET}\n"
        usage
        exit 1
        ;;
esac
