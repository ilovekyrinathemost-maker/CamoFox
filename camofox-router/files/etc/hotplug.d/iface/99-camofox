#!/bin/sh
# CamoFox Hotplug Script
# Automatically reconfigures CamoFox when the iPhone network interface comes up.
# Detects iPhone's IP address and updates proxy configuration.
#
# Triggered by OpenWrt's hotplug subsystem on interface events.
# Placed in /etc/hotplug.d/iface/ to receive network interface notifications.

. /lib/functions.sh

# Only act on interface up events
[ "$ACTION" = "ifup" ] || exit 0

# ---------------------------------------------------------------------------
# Load CamoFox configuration
# ---------------------------------------------------------------------------
config_load camofox
config_get ENABLED       main enabled       '0'
config_get AUTO_DETECT   main auto_detect   '1'
config_get CONN_MODE     main connection_mode 'usb'
config_get LOG_LEVEL     main log_level     '1'

# Exit if CamoFox is disabled or auto-detect is off
[ "$ENABLED" = "1" ] || exit 0
[ "$AUTO_DETECT" = "1" ] || exit 0

log_msg() {
    logger -t camofox-hotplug "$1"
}

# ---------------------------------------------------------------------------
# Determine if this interface event is relevant to CamoFox
# ---------------------------------------------------------------------------
# INTERFACE is set by hotplug to the logical interface name (e.g., "wan")
# DEVICE is set to the physical device name (e.g., "usb0", "wlan-sta0")

# USB tethering interfaces: usb0, eth2 (varies by firmware)
# WiFi client interface: wlan-sta0 (GL-iNet standard)
is_iphone_iface() {
    case "$CONN_MODE" in
        usb)
            case "$DEVICE" in
                usb0|eth2|eth1) return 0 ;;
            esac
            # Also check interface name
            case "$INTERFACE" in
                tethering|wan) return 0 ;;
            esac
            ;;
        wifi)
            case "$DEVICE" in
                wlan-sta0|wlan0-1|apcli0) return 0 ;;
            esac
            case "$INTERFACE" in
                wwan|stabridge|wan) return 0 ;;
            esac
            ;;
    esac
    return 1
}

is_iphone_iface || exit 0

log_msg "iPhone interface detected: INTERFACE=$INTERFACE DEVICE=$DEVICE ACTION=$ACTION"

# ---------------------------------------------------------------------------
# Detect iPhone's IP address (gateway of the new interface)
# ---------------------------------------------------------------------------
detect_iphone_ip() {
    # Method 1: Get gateway from UCI network config
    local gw
    gw=$(uci -q get "network.${INTERFACE}.gateway")
    if [ -n "$gw" ] && [ "$gw" != "0.0.0.0" ]; then
        echo "$gw"
        return 0
    fi

    # Method 2: Get gateway from routing table for the device
    gw=$(ip route show dev "$DEVICE" 2>/dev/null | grep default | awk '{print $3}' | head -1)
    if [ -n "$gw" ]; then
        echo "$gw"
        return 0
    fi

    # Method 3: Get peer address from interface (point-to-point USB)
    gw=$(ip addr show dev "$DEVICE" 2>/dev/null | grep 'peer' | awk '{print $4}' | cut -d'/' -f1 | head -1)
    if [ -n "$gw" ]; then
        echo "$gw"
        return 0
    fi

    # Method 4: Guess based on connection mode defaults
    case "$CONN_MODE" in
        usb) echo "172.20.10.1" ;;
        wifi) echo "172.20.10.1" ;;
    esac
}

# Wait briefly for DHCP to assign addresses
sleep 3

NEW_IP=$(detect_iphone_ip)

if [ -z "$NEW_IP" ]; then
    log_msg "WARNING: Could not detect iPhone IP address"
    exit 0
fi

# ---------------------------------------------------------------------------
# Check if IP has changed
# ---------------------------------------------------------------------------
config_get CURRENT_IP main proxy_ip '172.20.10.1'

if [ "$NEW_IP" = "$CURRENT_IP" ]; then
    log_msg "iPhone IP unchanged ($NEW_IP), ensuring services are running"
else
    log_msg "iPhone IP changed: $CURRENT_IP -> $NEW_IP"

    # Update UCI configuration
    uci set camofox.main.proxy_ip="$NEW_IP"
    uci commit camofox

    log_msg "Updated proxy_ip to $NEW_IP in UCI config"
fi

# ---------------------------------------------------------------------------
# Restart CamoFox services to pick up new configuration
# ---------------------------------------------------------------------------
if [ -x /etc/init.d/camofox ]; then
    log_msg "Restarting CamoFox services"
    /etc/init.d/camofox restart
else
    log_msg "WARNING: /etc/init.d/camofox not found or not executable"
fi

log_msg "Hotplug processing complete for $DEVICE ($NEW_IP)"
