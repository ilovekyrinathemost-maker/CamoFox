// CamoFox - redsocks configuration template
// Auto-generated by camofox management script
// Do not edit directly; modify /etc/config/camofox instead
//
// Placeholders replaced at runtime:
//   {{REDSOCKS_PORT}} - local redsocks listen port
//   {{PROXY_IP}}      - iPhone SOCKS5 proxy IP
//   {{PROXY_PORT}}    - iPhone SOCKS5 proxy port
//   {{PROXY_TYPE}}    - socks5 or http-connect
//   {{LOG_LEVEL}}     - log_debug on/off

base {
    log_debug = {{LOG_DEBUG}};
    log_info = on;
    log = "syslog:daemon";
    daemon = off;
    redirector = iptables;
}

redsocks {
    local_ip = 127.0.0.1;
    local_port = {{REDSOCKS_PORT}};
    ip = {{PROXY_IP}};
    port = {{PROXY_PORT}};
    type = {{PROXY_TYPE}};
    // redsocks will transparently redirect all TCP from LAN
    // through the iPhone's SOCKS5 proxy
}
