#!/bin/sh
# CamoFox Firewall Rules
# Transparent SOCKS5 redirect + TTL mangling + Kill switch + DNS leak prevention
#
# This script is called by the camofox init script.
# It reads configuration from UCI and applies iptables rules idempotently.
#
# Usage: /etc/camofox/firewall.rules {apply|remove|status}

. /lib/functions.sh

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------
load_config() {
    config_load camofox
    config_get PROXY_IP      main proxy_ip      '172.20.10.1'
    config_get PROXY_PORT    main proxy_port    '1080'
    config_get PROXY_TYPE    main proxy_type    'socks5'
    config_get REDSOCKS_PORT main redsocks_port '12345'
    config_get TTL_VALUE     main ttl_value     '65'
    config_get TTL_ENABLED   main ttl_enabled   '1'
    config_get KILL_SWITCH   main kill_switch   '1'
    config_get DOH_ENABLED   main doh_enabled   '1'
    config_get DOH_PORT      main doh_listen_port '5053'
    config_get LAN_IFACE     main lan_iface     'br-lan'
    config_get LOG_LEVEL     main log_level     '1'
}

# ---------------------------------------------------------------------------
# Logging helper
# ---------------------------------------------------------------------------
log_msg() {
    logger -t camofox-fw "$1"
    [ "$LOG_LEVEL" -ge 2 ] && echo "camofox-fw: $1"
}

# ---------------------------------------------------------------------------
# Remove all CamoFox iptables rules (idempotent)
# ---------------------------------------------------------------------------
remove_rules() {
    log_msg "Removing CamoFox firewall rules"

    # Remove PREROUTING jump to REDSOCKS chain
    while iptables -t nat -D PREROUTING -i "$LAN_IFACE" -p tcp -j REDSOCKS 2>/dev/null; do :; done

    # Flush and delete REDSOCKS chain
    iptables -t nat -F REDSOCKS 2>/dev/null
    iptables -t nat -X REDSOCKS 2>/dev/null

    # Remove TTL mangling rules
    while iptables -t mangle -D POSTROUTING -j TTL --ttl-set "$TTL_VALUE" 2>/dev/null; do :; done
    while ip6tables -t mangle -D POSTROUTING -j HL --hl-set "$TTL_VALUE" 2>/dev/null; do :; done

    # Remove DNS leak prevention rules
    while iptables -D FORWARD -i "$LAN_IFACE" -p udp --dport 53 -j DROP 2>/dev/null; do :; done
    while iptables -D INPUT -i "$LAN_IFACE" -p udp --dport 53 -j ACCEPT 2>/dev/null; do :; done
    while iptables -D INPUT -i "$LAN_IFACE" -p tcp --dport 53 -j ACCEPT 2>/dev/null; do :; done

    # Remove kill switch rules
    while iptables -D FORWARD -i "$LAN_IFACE" -p tcp -m state --state ESTABLISHED,RELATED -j ACCEPT 2>/dev/null; do :; done
    while iptables -D FORWARD -i "$LAN_IFACE" -j CAMOFOX_KILLSW 2>/dev/null; do :; done
    iptables -F CAMOFOX_KILLSW 2>/dev/null
    iptables -X CAMOFOX_KILLSW 2>/dev/null

    log_msg "Firewall rules removed"
}

# ---------------------------------------------------------------------------
# Apply CamoFox iptables rules
# ---------------------------------------------------------------------------
apply_rules() {
    # Always remove first for idempotency
    remove_rules

    log_msg "Applying CamoFox firewall rules"

    # -------------------------------------------------------------------
    # 1. REDSOCKS chain — transparent TCP redirect to local redsocks
    # -------------------------------------------------------------------
    iptables -t nat -N REDSOCKS

    # Exclude local/private/reserved addresses from SOCKS redirect
    # These should be routed normally (LAN, router management, etc.)
    iptables -t nat -A REDSOCKS -d 0.0.0.0/8 -j RETURN
    iptables -t nat -A REDSOCKS -d 10.0.0.0/8 -j RETURN
    iptables -t nat -A REDSOCKS -d 100.64.0.0/10 -j RETURN
    iptables -t nat -A REDSOCKS -d 127.0.0.0/8 -j RETURN
    iptables -t nat -A REDSOCKS -d 169.254.0.0/16 -j RETURN
    iptables -t nat -A REDSOCKS -d 172.16.0.0/12 -j RETURN
    iptables -t nat -A REDSOCKS -d 192.168.0.0/16 -j RETURN
    iptables -t nat -A REDSOCKS -d 224.0.0.0/4 -j RETURN
    iptables -t nat -A REDSOCKS -d 240.0.0.0/4 -j RETURN

    # Also exclude traffic destined for the proxy itself
    # (redsocks connects to proxy directly, must not loop)
    iptables -t nat -A REDSOCKS -d "$PROXY_IP" -j RETURN

    # Redirect all remaining TCP to local redsocks port
    iptables -t nat -A REDSOCKS -p tcp -j REDIRECT --to-ports "$REDSOCKS_PORT"

    # Apply REDSOCKS chain to all TCP from LAN interface
    iptables -t nat -A PREROUTING -i "$LAN_IFACE" -p tcp -j REDSOCKS

    log_msg "REDSOCKS transparent redirect active (port $REDSOCKS_PORT)"

    # -------------------------------------------------------------------
    # 2. TTL mangling (defense in depth)
    # -------------------------------------------------------------------
    if [ "$TTL_ENABLED" = "1" ]; then
        # Set IPv4 TTL on all outbound packets
        # 65 -> iPhone decrements to 64 -> looks like native iOS traffic
        iptables -t mangle -A POSTROUTING -j TTL --ttl-set "$TTL_VALUE"

        # Set IPv6 Hop Limit similarly
        ip6tables -t mangle -A POSTROUTING -j HL --hl-set "$TTL_VALUE" 2>/dev/null

        log_msg "TTL mangling active (TTL=$TTL_VALUE)"
    fi

    # -------------------------------------------------------------------
    # 3. DNS leak prevention
    # -------------------------------------------------------------------
    if [ "$DOH_ENABLED" = "1" ]; then
        # Allow DNS queries from LAN to reach the router's local DNS server
        # (dnsmasq listens on br-lan, forwards to https-dns-proxy)
        iptables -I INPUT -i "$LAN_IFACE" -p udp --dport 53 -j ACCEPT
        iptables -I INPUT -i "$LAN_IFACE" -p tcp --dport 53 -j ACCEPT

        # Block any DNS that tries to go directly to the internet
        # This prevents LAN devices from using their own DNS servers
        iptables -A FORWARD -i "$LAN_IFACE" -p udp --dport 53 -j DROP

        log_msg "DNS leak prevention active (forwarded DNS blocked, DoH enabled)"
    fi

    # -------------------------------------------------------------------
    # 4. Kill switch (block all non-proxied outbound if enabled)
    # -------------------------------------------------------------------
    if [ "$KILL_SWITCH" = "1" ]; then
        # Create kill switch chain (used by health monitor to toggle)
        iptables -N CAMOFOX_KILLSW 2>/dev/null || iptables -F CAMOFOX_KILLSW

        # Default: allow traffic (health monitor will insert DROP if proxy goes down)
        # When proxy is healthy, this chain is empty (RETURN implicit)
        iptables -A CAMOFOX_KILLSW -j RETURN

        # Allow established/related connections
        iptables -I FORWARD -i "$LAN_IFACE" -p tcp -m state --state ESTABLISHED,RELATED -j ACCEPT

        log_msg "Kill switch chain created (health monitor controls activation)"
    fi

    log_msg "All CamoFox firewall rules applied successfully"
}

# ---------------------------------------------------------------------------
# Activate kill switch (called by health monitor when proxy is DOWN)
# ---------------------------------------------------------------------------
activate_kill_switch() {
    log_msg "KILL SWITCH ACTIVATED — proxy unreachable, blocking traffic"
    iptables -F CAMOFOX_KILLSW 2>/dev/null
    iptables -A CAMOFOX_KILLSW -j DROP
    # Insert at top of FORWARD chain
    # Remove old jump first, then re-add to ensure position
    while iptables -D FORWARD -i "$LAN_IFACE" -j CAMOFOX_KILLSW 2>/dev/null; do :; done
    iptables -I FORWARD 1 -i "$LAN_IFACE" -j CAMOFOX_KILLSW
}

# ---------------------------------------------------------------------------
# Deactivate kill switch (called by health monitor when proxy is UP)
# ---------------------------------------------------------------------------
deactivate_kill_switch() {
    log_msg "Kill switch deactivated — proxy reachable, traffic flowing"
    iptables -F CAMOFOX_KILLSW 2>/dev/null
    iptables -A CAMOFOX_KILLSW -j RETURN
}

# ---------------------------------------------------------------------------
# Show status of CamoFox firewall rules
# ---------------------------------------------------------------------------
show_status() {
    echo "=== CamoFox Firewall Status ==="
    echo ""
    echo "--- NAT REDSOCKS Chain ---"
    iptables -t nat -L REDSOCKS -n -v 2>/dev/null || echo "  (not active)"
    echo ""
    echo "--- NAT PREROUTING (CamoFox entries) ---"
    iptables -t nat -L PREROUTING -n -v 2>/dev/null | grep -E "REDSOCKS|camofox" || echo "  (no entries)"
    echo ""
    echo "--- Mangle POSTROUTING (TTL) ---"
    iptables -t mangle -L POSTROUTING -n -v 2>/dev/null | grep -i ttl || echo "  (no TTL rules)"
    echo ""
    echo "--- Kill Switch Chain ---"
    iptables -L CAMOFOX_KILLSW -n -v 2>/dev/null || echo "  (not active)"
    echo ""
    echo "--- DNS Rules ---"
    iptables -L FORWARD -n -v 2>/dev/null | grep "dpt:53" || echo "  (no DNS rules)"
    echo ""
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
load_config

case "$1" in
    apply)
        apply_rules
        ;;
    remove)
        remove_rules
        ;;
    status)
        show_status
        ;;
    kill_on)
        activate_kill_switch
        ;;
    kill_off)
        deactivate_kill_switch
        ;;
    *)
        echo "Usage: $0 {apply|remove|status|kill_on|kill_off}"
        exit 1
        ;;
esac

exit 0
